{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "michael-ui": ["./packages/michael-ui/components/index.ts"],
      "michael-ui/locale/*": ["./packages/michael-ui/components/locale/*"],
      "antd": ["./packages/michael-ui/components/index.ts"],
      "antd/locale/*": ["./packages/michael-ui/components/locale/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/**/*",
    "apps/**/*"
  ],
  "exclude": [
    "node_modules",
    "packages/*/dist",
    "apps/*/.next"
  ]
}
