{
  "name": "michael-ui-monorepo",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:ui": "turbo build --filter=michael-ui",
    "build:docs": "turbo build --filter=@michael-ui/docs",
    "dev:docs": "turbo dev --filter=@michael-ui/docs",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "biome format --write .",
    "clean": "rimraf node_modules packages/*/dist packages/*/node_modules apps/*/.next apps/*/node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@changesets/cli": "^2.27.12",
    "@types/node": "^22.17.1",
    "prettier": "^3.5.1",
    "rimraf": "^6.0.1",
    "turbo": "^2.4.4",
    "typescript": "^5.9.3"
  }
}
